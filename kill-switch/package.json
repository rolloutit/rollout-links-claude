{
  "name": "cost-kill-switch",
  "version": "1.0.0",
  "private": true,
  "description": "Scheduled Cloudflare Worker: takes every other Worker on the account offline when month-to-date usage-based spend crosses a threshold",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "restore": "node scripts/restore.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Keep in sync with SELF in src/index.ts.
  "name": "cost-kill-switch",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Cron only: no public URL.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true },
  "kv_namespaces": [
    // npx wrangler kv namespace create KILL_SWITCH_STATE  → paste the id here
    { "binding": "STATE", "id": "296a76bb7f8e449f90f8be3021386ae8" }
  ],
  "vars": {
    "ACCOUNT_ID": "90d8ba2df8a9dda14cd583ec43726b1f",
    "THRESHOLD_USD": "100",
    // Anything but "false" only logs/notifies (use "true" to test).
    "DRY_RUN": "false",
    "EXCLUDE_SCRIPTS": ""
  }
  // Secrets (never in this file):
  //   npx wrangler secret put CF_API_TOKEN        (Account → Workers Scripts: Edit, Account → Account Analytics: Read)
  //   npx wrangler secret put SLACK_WEBHOOK_URL   (optional, Slack incoming webhook)
}
